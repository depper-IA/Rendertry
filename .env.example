# ── Supabase (proyecto propio de Rendertry — NO usar el de Lookitry) ───────────
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key   # server-side only

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=secreto-aleatorio-minimo-32-caracteres

# ── App URLs ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://tudominio.com

# ── n8n (orquesta las generaciones con Vertex AI) ─────────────────────────────
NEXT_PUBLIC_N8N_DESCRIPTOR_URL=https://n8n.ejemplo.com/webhook/descriptor

# ── Google Analytics / Tag Manager (opcional) ─────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Cloudflare Turnstile (opcional) ───────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu-turnstile-site-key

# ── Google OAuth (opcional) ───────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
